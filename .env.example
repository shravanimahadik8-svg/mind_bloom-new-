# Mind Bloom — Environment Configuration Template
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# NEVER put real secrets in this file.

# ============================================================
# REQUIRED: OpenRouter API Key for AI Chat & Session Analysis
# Get a free key at: https://openrouter.ai/keys
# ============================================================
OPENROUTER_API_KEY=

# ============================================================
# REQUIRED IN PRODUCTION: JWT Signing Secret
# Generate a strong random string (minimum 32 characters).
# Example command: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If not set locally, the app uses a hardcoded default (NOT safe for production).
# ============================================================
MOOD_BLOOM_SECRET=

# ============================================================
# REQUIRED IN PRODUCTION: PostgreSQL Database URL (Neon)
# Format: postgres://user:password@host/dbname?sslmode=require
# Leave empty for local development (uses SQLite automatically).
# ============================================================
DATABASE_URL=

# ============================================================
# OPTIONAL: Port override for local development (default: 3000)
# ============================================================
PORT=3000

# ============================================================
# OPTIONAL: Node environment ('development' or 'production')
# Set to 'production' in Vercel environment variables.
# ============================================================
NODE_ENV=development
